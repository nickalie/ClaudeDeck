{
  "name": "claudedeck",
  "version": "0.1.0",
  "description": "Decky Loader plugin — chat with Claude AI from SteamOS Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.6",
    "@eslint/js": "^10.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^10.6.0",
    "rollup": "^4.62.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "marked": "^17.0.6",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
