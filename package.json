{
  "name": "claudedeck",
  "version": "0.1.0",
  "description": "Decky Loader plugin — chat with Claude AI from SteamOS Game Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^10.1.0",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
